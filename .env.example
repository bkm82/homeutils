DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Required when deployed behind a reverse proxy, e.g.:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://homelab.development.braymoll.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# AUTH_MODE=local uses Django's own login form (default, good for dev).
# AUTH_MODE=remote_user trusts the Remote-User header set by an Authelia
# forward-auth proxy in front of the app - only use this when the app is
# unreachable except through that proxy.
AUTH_MODE=local
REMOTE_USER_HEADER=HTTP_REMOTE_USER

POSTGRES_DB=homeutils
POSTGRES_USER=homeutils
POSTGRES_PASSWORD=homeutils
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
